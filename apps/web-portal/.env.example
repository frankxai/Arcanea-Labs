# Arcanea Sora Environment Variables

# OpenAI API (for text-to-image generation)
OPENAI_API_KEY=your_openai_api_key_here

# Stability AI API (for image generation)
STABILITY_API_KEY=your_stability_api_key_here

# Replicate API (for video generation)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Google Cloud Vision API (for OCR/image-to-text)
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAX_FILE_SIZE=10485760  # 10MB in bytes

# Database (optional - for storing generation history)
DATABASE_URL=your_database_connection_string

# Redis (optional - for caching)
REDIS_URL=your_redis_connection_string

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes

# Feature Flags
ENABLE_VIDEO_GENERATION=true
ENABLE_IMAGE_GENERATION=true
ENABLE_OCR=true

